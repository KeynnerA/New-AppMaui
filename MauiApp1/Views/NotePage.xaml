<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1.Models"
             x:Class="MauiApp1.Views.NotePage"
             Title="NotePage">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="☑"
                     Priority="0"
                     Order="Primary"
                     IsEnabled="{Binding PuedeActivarModoLista}"
                     Clicked="ToggleEditorCheckboxToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.BindingContext>
        <local:NotasViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">

        <!-- Título de la nota -->
        <Entry Grid.Row="0"
               Placeholder="Título"
               Text="{Binding TituloEntryText}" />

        <!-- Contenido: texto plano o lista con varios checkboxes (solo al crear nota nueva) -->
        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <Editor x:Name="TextEditor"
                    IsVisible="{Binding UsaEditorTextoPlano}"
                    Text="{Binding NotaEntryText}"
                    Placeholder="Escribe tu nota aquí"
                    HeightRequest="100"/>

            <CollectionView ItemsSource="{Binding ItemsListaCheck}"
                            IsVisible="{Binding ModoListaCheckboxActivo}"
                            HeightRequest="220">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:NotaItemLista">
                        <Grid ColumnDefinitions="Auto,*" Padding="4" ColumnSpacing="8">
                            <CheckBox Grid.Column="0"
                                      VerticalOptions="Center"
                                      IsChecked="{Binding Marcado}" />
                            <Entry Grid.Column="1"
                                   Text="{Binding Texto}"
                                   Placeholder="Ítem de la lista" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Añadir línea"
                    IsVisible="{Binding ModoListaCheckboxActivo}"
                    Clicked="AnadirLineaLista_Clicked" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2" Padding="10" Spacing="10">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Grid.Column="0"
                        Text="Save"
                        Clicked="SaveButton_Clicked" />
                <Button Grid.Column="1"
                        Text="Delete"
                        Clicked="DeleteButton_Clicked"/>
            </Grid>

            <CollectionView ItemsSource="{Binding Notas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Padding="10">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold"/>
                                <Label Text="{Binding Contenido}" />
                                <Label Text="{Binding Fecha}" FontSize="10" TextColor="Gray"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Opcion"
                                    Clicked="EditButton_Clicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
