<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1.Models"
             xmlns:converters="clr-namespace:MauiApp1.Converters"
             x:Class="MauiApp1.Views.NotePage"
             Title="Mis Notas">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ContenidoNotaAFormattedStringConverter x:Key="ContenidoNotaAFormattedStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="..."
                     Priority="0"
                     Order="Primary"
                     Clicked="SortToolbarItem_Clicked" />
    </ContentPage.ToolbarItems>

    
    <Grid Padding="10">
        <CollectionView ItemsSource="{Binding Notas}"
                        VerticalOptions="FillAndExpand">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Padding="10">
                    <VerticalStackLayout Grid.Column="0">
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding EstaCompletada}" VerticalOptions="Center" />
                            <Label Text="{Binding Titulo}" FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding EstaCompletada}"
                                                 Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                        <Setter Property="TextColor" Value="Gray" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                        <Label Text="{Binding Prioridad}"
                               FontSize="11">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Prioridad}"
                                             Value="High">
                                    <Setter Property="TextColor" Value="Red" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Prioridad}"
                                             Value="Medium">
                                    <Setter Property="TextColor" Value="OrangeRed" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding Prioridad}"
                                             Value="Low">
                                    <Setter Property="TextColor" Value="Green" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <VerticalStackLayout IsVisible="{Binding TieneFormatoChecklist}"
                                                     BindableLayout.ItemsSource="{Binding LineasVisuales}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="local:NotaLineaVisual">
                                    <HorizontalStackLayout Spacing="6">
                                        <CheckBox IsChecked="{Binding Marcado}" VerticalOptions="Center" />
                                        <Label Text="{Binding Texto}" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                                     Binding="{Binding Marcado}"
                                                                     Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    <Setter Property="FontAttributes" Value="Bold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label IsVisible="{Binding MostrarTextoPlano}"
                                       FormattedText="{Binding Contenido, Converter={StaticResource ContenidoNotaAFormattedStringConverter}}" />
                        <Label IsVisible="{Binding TieneAlarma}"
                                       Text="{Binding HoraAlarmaTexto}"
                                       FontSize="11"
                                       TextColor="DarkOrange"/>
                        <Label Text="{Binding Fecha}" FontSize="10" TextColor="Gray"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                                    Text="Opcion"
                                    Clicked="EditButton_Clicked" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </Grid>
</ContentPage>
