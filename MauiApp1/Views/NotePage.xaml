<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1.Models"
             x:Class="MauiApp1.Views.NotePage"
             Title="NotePage">
    <ContentPage.BindingContext>
        <local:NotasViewModel />
    </ContentPage.BindingContext>
    
    <Grid>
    <VerticalStackLayout>
        <Editor  x:Name="TextEditor" 
                 Placeholder="Enter you note here"
                 HeightRequest="100"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="4" >
            <Button Text="Save"
                    Clicked="SaveButton_Clicked"/>

            <Button Grid.Column="1" Text="Delete"
                    Clicked="DeleteButton_Clicked"/>

        </Grid>
    </VerticalStackLayout>
    
    <VerticalStackLayout Padding="20">
        <!-- Entrada de texto -->
        <Entry x:Name="NotaEntry" Placeholder="Escribe tu nota aquí" />
        <!-- Botón para guardar -->
        <Button Text="Guardar Nota" Command="{Binding GuardarNotaCommand}" CommandParameter="{Binding Text, Source={x:Reference NotaEntry}}" />
        <!-- Lista de notas -->
        <CollectionView ItemsSource="{Binding Notas}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10">
                        <Label Text="{Binding Titulo}" FontAttributes="Bold"/>
                        <Label Text="{Binding Contenido}" />
                        <Label Text="{Binding Fecha}" FontSize="10" TextColor="Gray"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
    </Grid>
</ContentPage>